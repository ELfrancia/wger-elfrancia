# ==============================================================================
# ONYX WORKOUT - Modello di Configurazione Firma Release (Keystore)
# ==============================================================================
# ISTRUZIONI:
# 1. Copia questo file rinominandolo in 'keystore.properties' nella stessa directory:
#    mobile-app/android/keystore.properties
# 2. Compila i 4 campi sottostanti con i valori usati durante la generazione con keytool.
# 3. IMPORTANTE: NON committare MAI 'keystore.properties' o i file '.jks'/'.keystore' su Git!
#    (Sono già inseriti in .gitignore).
# ==============================================================================

# 1. storeFile: Percorso del file keystore (.jks o .keystore).
# Può essere un percorso relativo alla cartella mobile-app/android (es. onyx-release-key.jks o app/onyx-release-key.jks)
# oppure un percorso assoluto (es. C:/Users/nome/keystores/onyx-release-key.jks).
storeFile=onyx-release-key.jks

# 2. storePassword: Password del file keystore impostata durante l'esecuzione di keytool.
storePassword=your_keystore_password_here

# 3. keyAlias: Nome univoco (alias) assegnato alla chiave all'interno del keystore (parametro -alias di keytool).
keyAlias=onyx-release-key

# 4. keyPassword: Password della specifica chiave privata (nei moderni keystore PKCS12 coincide di norma con storePassword).
keyPassword=your_key_password_here
