# Example keystore configuration for Onyx release builds
# Copy this file to keystore.properties in the same directory (mobile-app/android/keystore.properties)
# WARNING: Do NOT commit keystore.properties or *.keystore files to Git!

storeFile=app/onyx-release-key.keystore
storePassword=your_store_password_here
keyAlias=onyx-release-key
keyPassword=your_key_password_here
